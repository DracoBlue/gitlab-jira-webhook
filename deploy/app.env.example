# Runtime configuration of the webhook container (docker --env-file format: KEY=value, no quotes).
# Copy to app.env and restrict access: chmod 600 app.env

# GitLab base URL, without trailing slash.
GITLAB_BASE_URL=https://git.example.org
# Token with read_api scope that can see the merge requests of all hooked projects
# (personal access token of a bot user, or a group access token).
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Shared secret; GitLab sends it in the X-Gitlab-Token header. Generate with: openssl rand -hex 32
GITLAB_WEBHOOK_TOKEN=change-me

# Jira Cloud site.
JIRA_BASE_URL=https://example.atlassian.net
# Atlassian account and its API token (https://id.atlassian.com/manage-profile/security/api-tokens).
# The account needs "Browse projects" and "Link issues" in the Jira projects.
JIRA_EMAIL=gitlab-bot@example.org
JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only link issues of these Jira projects (comma separated).
# Avoids calling Jira for things like "UTF-8" that look like issue keys.
#JIRA_PROJECT_KEYS=PROJ,OPS

# Optional settings
#LOG_LEVEL=info
#TZ=Europe/Amsterdam
#REQUEST_TIMEOUT_MS=10000
#ICON_URL_MAP_PATH=/config/icon-url-map.json
# Outgoing proxy for GitLab/Jira calls:
#HTTPS_PROXY=http://proxy.example.org:3128
#NO_PROXY=git.example.org
#NODE_USE_ENV_PROXY=1
