# Settings for install.sh and register-hooks.sh (shell syntax, sourced by bash).
# Copy to deploy.env and restrict access: chmod 600 deploy.env

# --- install.sh -------------------------------------------------------------

# Image to run. Pin a version tag; change it to update.
IMAGE=registry.example.org/group/gitlab-jira-webhook:2.0.0
CONTAINER_NAME=gitlab-jira-webhook
# Set to false when the image is loaded with `docker load` instead of pulled from a registry.
PULL=true

# Where the webhook listens on the host. Keep 127.0.0.1 when GitLab runs on the same host.
HOST_BIND=127.0.0.1
HOST_PORT=3000

# Registry credentials (deploy token with read_registry). Leave empty if already logged in.
REGISTRY_USER=
REGISTRY_TOKEN=

# CA bundle that signed the GitLab certificate, when it is not publicly trusted.
# On Omnibus this is often the file under /etc/gitlab/trusted-certs/ or /etc/ssl/certs/.
CA_CERT_FILE=

# Extra /etc/hosts entries for the container, space separated, e.g. "git.example.org:host-gateway"
# when the GitLab host name resolves only on the host itself.
EXTRA_HOSTS=

MEMORY_LIMIT=256m

# --- register-hooks.sh ------------------------------------------------------

# Token with api scope and Maintainer role on the projects (and admin for --allow-local-target).
GITLAB_ADMIN_TOKEN=
# URL that GitLab calls. With the defaults above and GitLab on the same host:
WEBHOOK_URL=http://127.0.0.1:3000/events
# File with one project per line (group/project or numeric ID); # starts a comment.
PROJECTS_FILE=projects.txt
# Verify TLS of WEBHOOK_URL (only matters for https URLs).
HOOK_SSL_VERIFY=true
